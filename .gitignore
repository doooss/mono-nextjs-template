# dependencies
node_modules
.pnp
.pnp.*

# build output (앱 / 패키지 루트에만 — src/app 아래 같은 이름의 라우트 폴더는 추적)
apps/*/.next/
apps/*/out/
apps/*/build/
apps/*/dist/
packages/*/dist/
*.tsbuildinfo
next-env.d.ts

# turbo
.turbo

